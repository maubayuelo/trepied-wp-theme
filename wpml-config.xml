<?xml version="1.0" encoding="UTF-8"?>
<!--
	WPML Configuration for Trepied Theme
	
	This file tells WPML how to handle theme strings and ACF fields.
	Place this file in the theme root for automatic detection.
	
	Documentation: https://wpml.org/documentation/support/language-configuration-files/
-->
<wpml-config>
	<!-- Admin Texts (wp_options) that should be translatable -->
	<admin-texts>
		<key name="blogname"/>
		<key name="blogdescription"/>
	</admin-texts>

	<!-- 
		ACF Field Groups - Translation Mode
		
		With ACFML (ACF Multilingual) installed, field values are automatically 
		handled based on these settings:
		
		action="translate" = Field value should be translated for each language
		action="copy" = Field value is copied (same across languages)
		action="copy-once" = Field value is copied only when creating translation
		
		Note: ACFML handles most of this automatically. This config provides 
		explicit control for specific fields.
	-->
	<custom-fields>
		<!-- Hero Section -->
		<custom-field action="translate">hero_copy</custom-field>
		<custom-field action="translate">hero_subtitle</custom-field>
		<custom-field action="copy">hero_video</custom-field>
		<custom-field action="translate">hero_image</custom-field>

		<!-- Services Section -->
		<custom-field action="translate">services_section_title</custom-field>
		<custom-field action="translate">services_section_description</custom-field>
		<custom-field action="translate">service_title</custom-field>
		<custom-field action="translate">service_description</custom-field>
		<custom-field action="translate">service_image</custom-field>
		<custom-field action="translate">service_link_text</custom-field>

		<!-- Projects Section -->
		<custom-field action="translate">projects_title</custom-field>
		<custom-field action="translate">projects_description</custom-field>
		<custom-field action="translate">project_title</custom-field>
		<custom-field action="translate">project_image</custom-field>
		<custom-field action="translate">project_client</custom-field>
		<custom-field action="translate">project_description</custom-field>
		<custom-field action="translate">project_long_description</custom-field>
		<custom-field action="copy">yt_video_id</custom-field>

		<!-- About Section -->
		<custom-field action="translate">about_title</custom-field>
		<custom-field action="translate">about_subtitle</custom-field>
		<custom-field action="translate">about_paragraph</custom-field>
		<custom-field action="translate">about_image</custom-field>

		<!-- Testimonials -->
		<custom-field action="translate">testimonials_title</custom-field>
		<custom-field action="translate">testimonial_client</custom-field>
		<custom-field action="translate">testimonial_role</custom-field>
		<custom-field action="translate">testimonial_text</custom-field>

		<!-- CTA Section -->
		<custom-field action="translate">cta_title</custom-field>
		<custom-field action="translate">cta_paragraph</custom-field>
	</custom-fields>

	<!-- 
		Language Switcher Settings
		These are available in WPML settings, but defined here as defaults
	-->
	<language-switcher-settings>
		<key name="icl_lso_link_empty">0</key>
		<key name="icl_lso_flags">0</key>
		<key name="icl_lso_native_lang">0</key>
		<key name="icl_lso_display_lang">1</key>
	</language-switcher-settings>
</wpml-config>
